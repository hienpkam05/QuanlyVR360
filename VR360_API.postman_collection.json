    {
      "name": "Tour Versions",
      "description": "Manage version history for a location. Draft/archived versions can be edited; published versions should be treated as read-only.",
      "item": [
        {
          "name": "List versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/locations/{{location_id}}/versions/?ordering=-version_number",
            "description": "List tour versions for a location. Draft and archived versions can be edited; published version is public-facing."
          }
        },
        {
          "name": "Create version JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/locations/{{location_id}}/versions/",
            "description": "Create a draft version with JSON body. Can include label, changelog and tour data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"v1\",\n  \"changelog\": \"Created from Postman\",\n  \"data\": {\n    \"scenes\": [],\n    \"initial_scene_id\": \"\",\n    \"settings\": {\n      \"auto_rotate\": true,\n      \"transition\": \"smooth\"\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('version_id', json.id);",
                  "if (json.version_number) pm.collectionVariables.set('version_number', json.version_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create version multipart audio + point logo",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/locations/{{location_id}}/versions/",
            "description": "Create a draft version with background audio and point hotspot logo files using multipart/form-data.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "label",
                  "type": "text",
                  "value": "v-new"
                },
                {
                  "key": "changelog",
                  "type": "text",
                  "value": "Created with background audio and point logo"
                },
                {
                  "key": "data",
                  "type": "text",
                  "value": "{\"scenes\": [], \"initial_scene_id\": \"\", \"settings\": {\"auto_rotate\": true, \"transition\": \"smooth\"}}"
                },
                {
                  "key": "background_audio",
                  "type": "file",
                  "src": "{{audio_file}}"
                },
                {
                  "key": "hotspot_point_logo",
                  "type": "file",
                  "src": "{{logo_file}}"
                }
              ]
            }
          }
        },
        {
          "name": "Version detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/locations/{{location_id}}/versions/{{version_id}}/",
            "description": "Get one version detail including tour_data and file URLs."
