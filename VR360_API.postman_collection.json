    {
      "name": "Publishing",
      "description": "Publish a location, switch published version, regenerate public token, and manage whitelist domains.",
      "item": [
        {
          "name": "List published tours for Home",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/published-tours/",
            "description": "Public list used by Home page cards. Shows active published tours only."
          }
        },
        {
          "name": "Get publish config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/locations/{{location_id}}/publish/",
            "description": "Get current publish config for a location: token, active status, published version and whitelist domains."
          }
        },
        {
          "name": "Publish location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/locations/{{location_id}}/publish/",
            "description": "Publish or switch published version for a location. Existing public token can stay stable so customer iframe updates automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"published_version\": \"{{version_id}}\",\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.public_token) pm.collectionVariables.set('public_token', json.public_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch publish config",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/locations/{{location_id}}/publish/",
