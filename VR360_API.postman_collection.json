  "item": [
    {
      "name": "Auth",
      "description": "JWT authentication APIs. Login first to save access and refresh tokens into collection variables.",
      "item": [
        {
          "name": "Login - get JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login/",
            "description": "Login with username/password. Test script should save access_token and refresh_token for later requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) pm.collectionVariables.set('access_token', json.access);",
                  "if (json.refresh) pm.collectionVariables.set('refresh_token', json.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/refresh/",
            "description": "Use refresh_token to generate a new access_token when the old access token expires.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) pm.collectionVariables.set('access_token', json.access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout - blacklist refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/logout/",
            "description": "Blacklist refresh_token so it can no longer be used.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/me/",
            "description": "Return the current logged-in user: username, is_staff, is_superuser and role flags used by the frontend."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/change-password/",
            "description": "Change password for current logged-in user. Useful after admin creates an employee account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"123456\",\n  \"new_password\": \"12345678Strong!\",\n  \"confirm_password\": \"12345678Strong!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "description": "Manage VR360 projects. Delete endpoints use soft delete, not hard delete.",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/projects/?search=&ordering=-created_at",
            "description": "List active projects. Supports search, ordering and pagination."
          }
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/projects/",
            "description": "Create a new project. Slug can be auto-generated by backend if omitted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo VR360\",\n  \"description\": \"Demo project\",\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('project_id', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Project detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/projects/{{project_id}}/",
            "description": "Get one active project by project_id."
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/projects/{{project_id}}/",
            "description": "Patch editable project fields such as name, description, thumbnail or is_active.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo VR360 updated\",\n  \"description\": \"Updated description\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Upload project thumbnail",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/projects/{{project_id}}/upload-thumbnail/",
            "description": "Upload/replace project thumbnail using multipart/form-data.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "thumbnail",
                  "type": "file",
                  "src": "{{thumbnail_file}}"
                }
              ]
            }
          }
        },
        {
          "name": "Project dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/projects/{{project_id}}/dashboard/",
            "description": "Small dashboard scoped to one project: locations, versions/assets and visit stats."
          }
        },
        {
          "name": "Soft delete project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/projects/{{project_id}}/",
            "description": "Soft delete project. Record is marked deleted instead of being removed permanently."
          }
        }
      ]
    },
