# Copy file nay thanh .env de chay backend local.
# Khong commit file .env that vi co mat khau / secret.

# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database mac dinh cho local.
# Neu team dung chung database online thi thay bang URL PostgreSQL chung.
DATABASE_URL=postgresql://user:password@localhost:5432/managementvr360_db

# Frontend duoc phep goi API backend.
# Local Vue/Vite mac dinh chay port 5173.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Celery / Redis neu sau nay dung xu ly background.
# Co the de mac dinh neu chua chay worker.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
